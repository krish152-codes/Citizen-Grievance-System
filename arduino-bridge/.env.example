# Copy this file to ".env" and edit.

# Where the backend API lives.
#   Local:   http://localhost:5000/api
#   Render:  https://YOUR-BACKEND.onrender.com/api
API_BASE_URL=http://localhost:5000/api

# COM port of the Arduino (see Arduino IDE → Tools → Port). Leave empty to auto-detect.
SERIAL_PORT=COM8
BAUD_RATE=9600

# Only needed if DEVICE_INGEST_KEY is set on the backend (recommended on Render).
DEVICE_KEY=

# Optional: send every reading to this drain's database id instead of matching by device_id.
DRAIN_ID=

# How often a reading is saved (milliseconds).
POST_EVERY_MS=2000
